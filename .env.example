# Origin only, without a repository path. Leave blank for local preview.
PUBLIC_SITE_URL=
# For a project repository on GitHub Pages, use /your-repo-name.
BASE_PATH=/
# Square Appointments: paste the public "Book now" link (Square Dashboard > Appointments > Online Booking).
# Every "Book a session" button on the site opens this link in a new tab.
PUBLIC_BOOKING_URL=
# Optional: Square's embeddable widget script, to show the booking calendar inline on /book/.
# Square Dashboard > Appointments > Online Booking > Embed > copy the src of the <script> tag.
PUBLIC_BOOKING_EMBED_SRC=
# Shown in the footer and on /book/. Leave blank to hide.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
# Instagram handle without the @, e.g. formandfield
PUBLIC_CONTACT_INSTAGRAM=
# Set true only when approved content and booking details are ready to launch.
PUBLIC_SITE_LIVE=false
